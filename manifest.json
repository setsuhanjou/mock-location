{
  "manifest_version": 3,
  "name": "Mock Location",
  "version": "1.2.0",
  "description": "DevTools の Sensors と同じ仕組みで、Chrome の位置情報を地図上で指定した座標・路線に上書きする開発用拡張機能",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mock Location コントロール画面を開く",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
